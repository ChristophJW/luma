# Copy to .env — `make setup` does this for you.
# Local development only. Never put production values here.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=dev-only-not-secret-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Postgres (docker compose: host port 5442 to avoid clashing) ----------
POSTGRES_DB=luma
POSTGRES_USER=luma
POSTGRES_PASSWORD=luma
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442
DATABASE_URL=postgres://luma:luma@127.0.0.1:5442/luma

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6390/0
CELERY_BROKER_URL=redis://127.0.0.1:6390/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6390/2

# --- Object storage (MinIO locally, S3-compatible in production) ----------
# Production must be an EU region. See CHECKLIST.md §3.
S3_ENDPOINT_URL=http://127.0.0.1:9010
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9010
S3_ACCESS_KEY_ID=lumaminio
S3_SECRET_ACCESS_KEY=lumaminio
S3_REGION=eu-central-1
S3_BUCKET_ORIGINALS=luma-originals
S3_BUCKET_DERIVATIVES=luma-derivatives

# --- Email (Mailpit locally — catches everything, sends nothing) ----------
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1035
DEFAULT_FROM_EMAIL=hello@luma.local

# --- Frontends ------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
GUEST_BASE_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8081,http://localhost:8081

# --- Feature flags --------------------------------------------------------
# Face lookup is off by default, globally and per event. See CONCEPT.md §7.
FEATURE_FACE_LOOKUP=false
